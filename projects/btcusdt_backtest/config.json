{
  "project_id": "P-BTCUSDT-BACKTEST",
  "name": "BTCUSDT User-Strategy Backtesting",
  "purpose": "Analyze user-supplied strategy rules or images, formalize them, and backtest faithfully",
  "status": "INTAKE_READY_ENGINE_VALIDATION_PENDING_DATA",
  "independent_from": "strategy_hunter",
  "timeframes_minutes_supported": [1, 5, 15, 30, 60, 240, 1440],
  "source_file": "data/btcusdt/btcusdt_1m.csv",
  "output_dir": "artifacts/btcusdt_backtest",
  "strategy_specs_dir": "projects/btcusdt_backtest/strategies",
  "strategy_intake_guide": "projects/btcusdt_backtest/STRATEGY_INTAKE.md",
  "starting_capital_usdt": 1000,
  "market_types_supported": ["spot", "usdt_perpetual"],
  "base_asset": "BTC",
  "quote_asset": "USDT",
  "research_only": true,
  "place_orders": false,
  "strategy_source": "owner_supplied_text_or_image",
  "strategy_discovery_mode": false,
  "must_preserve_user_rules": true,
  "must_separate_faithful_replication_from_variants": true,
  "required_metrics": [
    "trades",
    "wins",
    "losses",
    "win_rate_pct",
    "monthly_net_return_usdt",
    "monthly_net_return_pct",
    "average_winner_usdt",
    "average_loser_usdt",
    "profit_factor",
    "expectancy_usdt_per_trade",
    "max_drawdown_usdt",
    "max_drawdown_pct",
    "largest_loss_usdt",
    "losing_streak",
    "total_costs_usdt"
  ],
  "required_validation": ["source_provenance", "data_integrity", "no_lookahead", "fees_and_slippage", "development_validation_holdout", "walk_forward", "parameter_stability", "market_type_and_position_size_check"],
  "risk_gate_max_drawdown_pct": 10,
  "notes": "The Owner supplies strategy details or an image. Leverage extracts rules, records interpretation/ambiguities, converts to a versioned machine-readable spec, and tests that strategy. No generic strategy may be substituted silently. No perfousdtance result may be generated from empty or synthetic data.",
  "engine_status": "IMPLEMENTED_AWAITING_CI_VERIFICATION",
  "supported_indicators": [
    "sma",
    "ema",
    "rsi",
    "atr",
    "bollinger",
    "bollinger_bands"
  ],
  "supported_condition_operators": [
    "gt",
    "gte",
    "lt",
    "lte",
    "eq",
    "neq",
    "crosses_above",
    "crosses_below"
  ],
  "supported_exit_modes": [
    "stop_and_target",
    "fixed_stop_target",
    "opposite_signal",
    "time_exit",
    "stop_target_or_signal",
    "stop_target_or_time"
  ],
  "unsupported_rules_must_fail": [
    "trailing_stop",
    "partial_exit",
    "dynamic_risk_sizing",
    "order_queue_simulation",
    "automatic_contract_roll"
  ],
  "default_workflow_behavior": "validate_and_test_only_unless_strategy_path_is_explicitly_supplied"
}
