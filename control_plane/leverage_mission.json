{
  "schema_version": 3,
  "mission": "Leverage",
  "active_track": "strategy_hunter",
  "current_phase": "FOUNDATION_STRATEGY_DISCOVERY",
  "objective": "First identify and validate the strongest repeatable Shariah-compliant trading strategy or strategy framework; do not prematurely optimize for a single instrument. After the core edge is proven, map and adapt it by market and holding horizon for the Owner's broader trading and investing roadmap. Owner-mentioned strategies and instruments are seeds, never the search boundary.",
  "long_term_roadmap": {
    "phase_1": "Find and prove the strongest core trading edge before expanding.",
    "phase_2": {
      "name": "SCALPING",
      "primary_instrument": "FCPO",
      "requirements": [
        "instrument-specific microstructure/data",
        "Shariah compliance verification",
        "fees/slippage/margin realism",
        "separate intraday risk controls"
      ]
    },
    "phase_3": {
      "name": "INTRADAY_AND_SHORT_SWING",
      "markets": [
        "Malaysia",
        "global markets"
      ],
      "requirements": [
        "historical Shariah screening by market/date",
        "market-specific execution costs",
        "long and short eligibility where Shariah permits",
        "timeframe-specific validation"
      ]
    },
    "phase_4": {
      "name": "LONG_SWING_AND_POSITION_TRADING",
      "markets": [
        "Malaysia",
        "global markets"
      ],
      "requirements": [
        "multi-year out-of-sample robustness",
        "regime robustness",
        "portfolio/capital scaling"
      ]
    },
    "phase_5": {
      "name": "INVESTING",
      "asset_classes": [
        "unit trusts",
        "property",
        "gold",
        "other suitable investment opportunities"
      ],
      "requirements": [
        "return/risk/cost/liquidity/tax analysis",
        "Shariah compliance where applicable",
        "separate investment framework from active trading"
      ]
    }
  },
  "constraints": {
    "starting_capital_rm": 1000,
    "one_active_position": true,
    "planned_max_drawdown": 0.1,
    "target_trades_per_month": [
      5,
      20
    ],
    "shariah_required": true,
    "execution_universe": [
      "Moomoo",
      "Phillip Nova"
    ],
    "research_only_until_all_gates_pass": true,
    "live_money_movement": false,
    "costs_must_be_included": true,
    "survivorship_bias_must_be_tested": true,
    "lookahead_bias_must_be_tested": true,
    "strategy_discovery_policy": {
      "owner_examples_are_nonbinding": true,
      "owner_instruments_are_nonbinding": true,
      "open_ended_research": true,
      "external_research_required": true,
      "autonomous_hypothesis_generation": true,
      "must_search_across_strategy_families": true,
      "must_allow_unknown_combinations": true,
      "rr_must_be_discovered": true,
      "timeframe_must_be_discovered_when_data_supports_it": true,
      "instrument_and_horizon_must_be_treated_as_separate_validation_dimensions": true,
      "never_declare_best_from_in_sample_or_single_search_winner": true,
      "do_not_expand_to_live_multi_instrument_execution_until_core_strategy_gate_is_achieved": true
    }
  },
  "achievement_gates": [
    "data_integrity",
    "engine_sanity",
    "positive_after_costs",
    "robust_out_of_sample",
    "drawdown_within_limit",
    "trade_frequency_feasible",
    "broker_feasible_at_rm1000",
    "historical_shariah_compliance",
    "independent_replication",
    "forward_paper_validation"
  ],
  "stop_policy": {
    "default": "continue",
    "ordinary_research_failure": "recover_and_continue",
    "optional_tool_failure": "bypass_and_continue",
    "worker_failure": "restart_or_reassign",
    "only_stop_for": [
      "genuine_external_blocker_requiring_owner_action",
      "explicit_owner_stop",
      "goal_achieved"
    ]
  }
}
